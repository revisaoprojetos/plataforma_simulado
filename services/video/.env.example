# Copie para .env e preencha. NUNCA commite o .env.
NODE_ENV=development
PORT=3000

# S3 (Hetzner Object Storage)
S3_ENDPOINT=https://hel1.your-objectstorage.com
S3_REGION=hel1
S3_BUCKET=revisaopge-videos
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=false

# Upload (bytes). Padrão: 10 GiB
MAX_UPLOAD_BYTES=10737418240

# Worker de transcode (opcionais)
# WORKER_CONCURRENCY=1
# FFMPEG_PRESET=veryfast

# Playback (opcionais; valores padrão abaixo)
# PLAYBACK_TOKEN_TTL=5m
# PROGRESS_FLUSH_INTERVAL_MS=5000
# HLS_SEGMENT_URL_TTL=1h
# MAX_CONCURRENT_STREAMS=2
# Origens do front liberadas no CORS da API (separadas por vírgula)
CORS_ORIGINS=http://localhost:5173

# Segurança e operação (opcionais; em produção veja .env.prod.example)
# RATE_LIMIT_ENABLED=true
# TRUST_PROXY=0            # nº de proxies reversos à frente da API
# LOG_LEVEL=info
# METRICS_TOKEN=           # 16+ caracteres; vazio = /metrics desligado
# SWAGGER_ENABLED=true     # em produção o padrão é desligado
# ACCESS_ENDPOINT_ENABLED=false  # API de integração (matrícula e sessão do aluno); ver docs/operacao.md

# Infra
DATABASE_URL=postgresql://video:video@postgres:5432/video
REDIS_URL=redis://redis:6379

# Auth
JWT_ACCESS_SECRET=troque-por-um-segredo-longo
JWT_REFRESH_SECRET=troque-por-outro-segredo-longo
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
