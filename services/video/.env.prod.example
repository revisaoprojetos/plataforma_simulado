# Modelo para produção. Copie para .env.prod (fora do git) e preencha.
# Gere segredos com:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Use senhas só com letras e números (hex/base64url): elas entram em URLs de conexão.

NODE_ENV=production

# --- Banco e Redis (o compose monta DATABASE_URL e REDIS_URL com estas senhas) ---
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# --- Armazenamento S3 (Hetzner) ---
S3_ENDPOINT=https://hel1.your-objectstorage.com
S3_REGION=hel1
S3_BUCKET=revisaopge-videos
# Prefira uma chave restrita a este bucket.
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=false

# --- Autenticação (dois segredos DIFERENTES, 32+ caracteres) ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- Segurança de borda ---
# Domínio(s) do front, separados por vírgula. localhost é recusado em produção.
CORS_ORIGINS=https://cursos.suaempresa.com
# Quantos proxies reversos existem à frente da API (1 = Caddy/Nginx). Define o IP real do cliente.
TRUST_PROXY=1
RATE_LIMIT_ENABLED=true
# Swagger em /docs: desligado em produção, a menos que true.
SWAGGER_ENABLED=false
# API de integração com o sistema de origem (opcional; cada empresa ainda precisa ser habilitada)
ACCESS_ENDPOINT_ENABLED=false

# --- Observabilidade ---
LOG_LEVEL=info
# Token (Bearer) para o Prometheus ler /metrics da API (porta 3000) e do worker (porta 9100).
# Vazio = /metrics desligado.
METRICS_TOKEN=

# --- Limites ---
MAX_UPLOAD_BYTES=10737418240
MAX_CONCURRENT_STREAMS=2
WORKER_CONCURRENCY=1

# --- Onde a API escuta no host (o TLS fica no proxy reverso) ---
API_BIND=127.0.0.1:3000
