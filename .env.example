# =====================================================================
# Variáveis de ambiente — plataforma_simulado
# Copie para `.env` e preencha com valores reais. NUNCA commite o `.env`.
# Deploy em produção: ver docs/deploy/runbook-vps.md
# =====================================================================

NODE_ENV=development

# --- Supabase (Postgres/Auth/Storage gerenciado) --------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Postgres direto p/ hotspots de relatório (Fase 1). Sem isto, tudo segue em PostgREST. --
# Connection string do POOLER do Supabase (Settings → Database → Connection string →
# "Transaction"/"Session pooler"), com a senha do banco. Ex.:
#   postgresql://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:6543/postgres
DATABASE_URL=
DATABASE_POOL_MAX=5
# Fase 4 (opcional): read-replica do Supabase (Pro). Se setado, os RELATÓRIOS (só leitura)
# leem daqui em vez do primário. Mesmo formato do pooler. Vazio = usa DATABASE_URL.
DATABASE_URL_REPLICA=
# REPORT_SQL: vazio/'on' = usa SQL direto quando DATABASE_URL existir; 'shadow' = roda os dois
# e loga divergências mas serve o PostgREST (validação segura); 'off' = desliga o SQL direto.
REPORT_SQL=

# --- API dedicada (apps/api, Fase 3 — strangler). Vazio no web = relatórios seguem local. ------
# No serviço `web`: se RELATORIOS_API_URL apontar pra API, o web busca os relatórios extraídos
# lá (ex.: http://api:3001 na rede docker). API_INTERNAL_SECRET autentica web→api (mesmo valor
# nos dois serviços). No serviço `api`: DATABASE_URL + API_INTERNAL_SECRET.
RELATORIOS_API_URL=
API_INTERNAL_SECRET=

# --- Cache de relatórios (Redis, Fase 0). Vazio = ligado; 'off' = desliga. TTL em segundos. --
RELATORIO_CACHE=
RELATORIO_CACHE_TTL=600

# --- Fila / PDF (Redis + Gotenberg, consumidos pelo worker) ---------------
REDIS_URL=redis://localhost:6379
GOTENBERG_URL=http://localhost:3001
WEB_INTERNAL_URL=http://localhost:3000
PDF_RENDER_SECRET=
PDF_PUBLIC_BASE=

# --- Segredos internos da app -----------------------------------------------
CRON_SECRET=
APP_ENCRYPTION_KEY=
ALUNO_SESSION_SECRET=

# --- Curseduca (integração externa) ------------------------------------------
CURSEDUCA_API_KEY=
CURSEDUCA_BASE_URL=https://prof.curseduca.pro
CURSEDUCA_USER=
CURSEDUCA_PASS=
CURSEDUCA_WEBHOOK_SECRET=
CURSEDUCA_ENV_TENANT_ID=

# --- App pública / multi-tenant -----------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_TENANT_SLUG=demo
# Domínio do cookie de sessão. Setado (ex.: ".revisaopge.com.br", com o ponto inicial),
# a sessão vale em TODOS os subdomínios → login compartilhado entre plataformas (trocar
# sem relogar). Vazio (dev/localhost) = por-host, comportamento antigo. É BUILD-TIME
# (NEXT_PUBLIC_*, inlinado no bundle) — em produção o valor entra pelo build-arg do
# workflow (.github/workflows/docker-publish.yml), NÃO por env de runtime no Portainer.
NEXT_PUBLIC_COOKIE_DOMAIN=

# Liga os SIMULADOS DISCURSIVOS (envio por imagem + correção). Sem isto (ou != 'true'),
# a discursiva fica escondida. BUILD-TIME (NEXT_PUBLIC_*, inlinado no bundle).
NEXT_PUBLIC_DISCURSIVA_ATIVA=

# --- Storage -----------------------------------------------------------------
# Provider de arquivos: 'supabase' (atual) | 's3' (Hetzner/R2/MinIO/AWS) | 'gcs'.
# Para MIGRAR para o Hetzner Object Storage (S3-compatível), deixe STORAGE_PROVIDER=s3
# e preencha as chaves abaixo. ANTES de virar o sistema, rode:  node scripts/_verify-s3.mjs
STORAGE_PROVIDER=supabase
# Hetzner Object Storage (região Helsinki = hel1; outras: fsn1, nbg1).
S3_ENDPOINT=https://hel1.your-objectstorage.com
S3_REGION=hel1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# PREFIXO de bucket. Nomes de bucket no Hetzner são GLOBALMENTE únicos entre TODOS os clientes, então
# 'conteudos'/'imagens'/'pdfs' já estão tomados. O provider S3 prefixa os nomes LÓGICOS por este valor
# (ex.: 'conteudos' → 'revisaopge-conteudos'). O código e a coluna simulado_arquivos.bucket seguem
# usando os nomes lógicos — só a borda do provider mapeia. Vazio = sem prefixo (AWS/R2/MinIO próprios).
S3_BUCKET_PREFIX=revisaopge-
# URL pública base p/ objetos públicos (opcional; sem isto usa <endpoint>/<bucket-físico>/<path>).
# Ex. virtual-hosted: https://revisaopge-imagens.hel1.your-objectstorage.com
S3_PUBLIC_BASE_URL=
# Buckets LÓGICOS (o prefixo acima vira o físico; os físicos precisam existir no Hetzner — rode
# node scripts/_s3-provision.mjs --create p/ criar revisaopge-conteudos/imagens/pdfs/discursivas/backups/cadernos):
STORAGE_CONTENT_BUCKET=conteudos
STORAGE_IMAGE_BUCKET=imagens
# (GCS — alternativa, não usado)
GCS_PROJECT_ID=
GCS_CLIENT_EMAIL=
GCS_PRIVATE_KEY=

# --- Cronograma de estudos (em construção) --------------------------------
# Mostra o módulo no menu do admin e do aluno. Sem isto (ou != true), fica escondido.
# O gate por tenant é a coluna `ativo` de simulado_cronograma_config.
NEXT_PUBLIC_CRONOGRAMA_ATIVO=
